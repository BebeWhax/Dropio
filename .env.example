# Copy to .env and fill in. Any integration left blank runs on clearly labelled demo data.

DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"

# CJ Dropshipping (supplier cost + shipping): https://developers.cjdropshipping.com
# API key from CJ → My CJ → Authorization → API. Free accounts are limited to 1 request/second.
CJ_API_KEY=""

# eBay Browse API (selling prices per country): https://developer.ebay.com/my/keys
# Use the production keyset; set EBAY_ENV="sandbox" only for sandbox keys (very little data there).
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_ENV="production"

# Ukraine prices via Google Shopping (SerpApi): https://serpapi.com/manage-api-key
# Free tier ≈ 250 searches/month; results are cached 12h.
SERPAPI_KEY=""

# LiqPay (PrivatBank) subscriptions in UAH: https://www.liqpay.ua/admin → API keys.
# Use the sandbox_ key pair for testing. Callbacks go to APP_URL/api/billing/liqpay/callback,
# so APP_URL must be publicly reachable (e.g. an ngrok/cloudflared tunnel in development).
LIQPAY_PUBLIC_KEY=""
LIQPAY_PRIVATE_KEY=""

# monobank acquiring (plata by mono) subscriptions in UAH: https://web.monobank.ua → X-Token.
# A free test token is available at https://api.monobank.ua/. Webhooks go to APP_URL/api/billing/monobank/webhook.
MONOBANK_TOKEN=""

# Stripe subscriptions: https://dashboard.stripe.com/test/apikeys
# Without STRIPE_SECRET_KEY, plan upgrades are simulated locally (disabled in production).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Recurring monthly Price IDs for the paid plans (price_...).
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
