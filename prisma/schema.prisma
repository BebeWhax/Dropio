// SQLite for local development. For production switch provider to "postgresql"
// and point DATABASE_URL at your Postgres instance.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  // Subscription state, kept in sync by the payment providers' webhooks.
  plan               String    @default("free") // free | starter | pro
  subscriptionStatus String    @default("none") // none | active | trialing | past_due | canceled
  billingProvider    String? // stripe | liqpay | monobank | demo
  // Stripe subscription id, or the BillingSubscription id for LiqPay/Monobank.
  subscriptionRef    String?   @unique
  stripeCustomerId   String?   @unique
  currentPeriodEnd   DateTime?

  // JSON overrides for per-country cost assumptions (duty, fees, ...).
  costSettings String?

  // Interface language: en | uk.
  locale String @default("en")

  sessions             Session[]
  usageEvents          UsageEvent[]
  savedProducts        SavedProduct[]
  billingSubscriptions BillingSubscription[]
  bulkJobs             BulkJob[]
  imageSearches        ImageSearch[]
}

model Session {
  // SHA-256 of the cookie token, so a leaked DB can't be used to log in.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String // search | analysis
  // Identifies the request (e.g. hashed query) so reloading a page doesn't count twice.
  ref       String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

model SavedProduct {
  id            String   @id @default(cuid())
  userId        String
  source        String // cj | custom
  externalId    String
  title         String
  imageUrl      String?
  // Full AnalysisResult snapshot as JSON, so saved items render without new API calls.
  analysis      String
  bestCountry   String?
  bestMarginPct Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
}

// Shared cache for third-party API responses and provider access tokens,
// so repeated searches don't burn eBay/CJ quotas.
model ApiCache {
  key       String   @id
  value     String
  expiresAt DateTime

  @@index([expiresAt])
}

// One row per LiqPay/Monobank subscription checkout. Its id is the order reference
// sent to the provider, so callbacks can be matched back to a user and plan.
model BillingSubscription {
  id               String    @id @default(cuid())
  userId           String
  provider         String // liqpay | monobank
  plan             String
  amountMinor      Int // kopecks
  currency         String
  status           String    @default("pending") // pending | active | past_due | canceled
  // Monobank subscriptionId (LiqPay identifies subscriptions by our id as order_id).
  providerRef      String?   @unique
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A CSV upload: one job, one row per product, processed in the background.
model BulkJob {
  id        String    @id @default(cuid())
  userId    String
  fileName  String
  status    String    @default("queued") // queued | running | done
  // Analysis options applied to every row (JSON: countries, category, shipping, payer).
  options   String
  totalRows Int
  doneRows  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows      BulkRow[]

  @@index([userId, createdAt])
}

model BulkRow {
  id       String  @id @default(cuid())
  jobId    String
  position Int
  title    String
  cost     Float?
  shipping Float?
  gtin     String?
  queryUa  String?
  status   String  @default("pending") // pending | done | failed
  // AnalysisResult JSON once processed.
  result   String?
  error    String?
  job      BulkJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, position])
}

// A search-by-image. The (downscaled) photo is stored so services that need a
// public URL (CJ, Google Lens) can fetch it from /api/img/<publicToken>.
model ImageSearch {
  id          String   @id @default(cuid())
  userId      String
  // Random, unguessable token used in the public image URL.
  publicToken String   @unique
  imageMime   String
  imageData   Bytes
  country     String
  hint        String?
  // ImageSearchResult JSON.
  result      String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
